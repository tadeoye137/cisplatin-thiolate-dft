&CONTROL
  calculation  = 'relax'
  prefix       = 'thiolate'
  pseudo_dir   = './pseudo/'
  outdir       = './tmp/'
  tprnfor      = .true.
  tstress      = .false.
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav        = 1
  celldm(1)    = 30.0
  nat          = 5
  ntyp         = 3
  ecutwfc      = 40.0
  ecutrho      = 320.0
  occupations  = 'smearing'
  smearing     = 'gaussian'
  degauss      = 0.005
  assume_isolated = 'mt'
  tot_charge   = -1.0
/
&ELECTRONS
  conv_thr     = 1.0d-8
  mixing_beta  = 0.3
/
&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  S    32.065  S.pbe-n-rrkjus_psl.1.0.0.UPF
  C    12.011  C.pbe-n-rrkjus_psl.1.0.0.UPF
  H     1.008  H.pbe-rrkjus_psl.1.0.0.UPF

K_POINTS gamma

ATOMIC_POSITIONS angstrom
  S     8.000   8.000   8.000
  C     8.000   8.000   9.800
  H     8.000   9.030  10.200
  H     8.892   7.485  10.200
  H     7.108   7.485  10.200
